# Copy this file to .env. Put your API key only in your local .env.
# Meta Model API key for Muse (created in the Model API dashboard).
MUSE_API_KEY=replace_with_your_local_api_key
# Optional; defaults to muse-spark-1.3.
# MUSE_MODEL=muse-spark-1.3
# Optional if Tesseract is not on PATH (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
