# Copy this file to .env. Put your API key only in your local .env.
GEMINI_API_KEY=replace_with_your_local_api_key
# Stable text model listed in official Gemini docs, checked 2026-10-24.
# Availability depends on your account and region; override this when needed.
GEMINI_MODEL=gemini-3.8-flash
# Optional if Tesseract is not on PATH (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
