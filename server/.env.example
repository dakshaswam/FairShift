# Copy this file to server/.env, fill it in, then restart the server.
# Check your setup any time with:  npm run doctor   (from the project root)

# https://serpapi.com -> your API key (powers "Help near you" and "Find a better job")
SERPAPI_KEY=

# Google sign-in: Google Cloud -> Credentials -> OAuth client ID ("Web application"),
# with http://localhost:8443 under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Any long random string; signs login cookies. Changing it signs everyone out.
SESSION_SECRET=

# Meta Model API key for the assistant chat (Muse)
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3

PORT=8787
CACHE_TTL_MINUTES=360
